FROM python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535
WORKDIR /app
COPY uv.lock /app/uv.lock
COPY scripts/locked_docker_requirements.py /app/scripts/locked_docker_requirements.py
RUN python /app/scripts/locked_docker_requirements.py /app/uv.lock > /tmp/locked-requirements.txt \
    && python -m pip install --index-url https://pypi.org/simple --no-cache-dir --only-binary=:all: --require-hashes --no-deps -r /tmp/locked-requirements.txt \
    && python -m pip check \
    && rm /tmp/locked-requirements.txt
COPY src /app/src
COPY scripts/control_plane.py /app/scripts/control_plane.py
ENV PYTHONPATH=/app/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "scripts/control_plane.py"]
